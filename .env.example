# Copy to .env and fill in. Never commit .env.
#
# Google AI Studio / Gemini API key, used server-side only.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for complaint analysis (Gemma 4, multimodal: text + image input)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional ALTERNATIVE model to use only when you deliberately retry with it.
# Not applied automatically on quota errors.
# GEMMA_MODEL=gemma-4-31b-it

# API base URL (override only for a proxy or self-hosted endpoint)
GEMMA_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Server port
PORT=8787

# Optional: return clearly-labelled SAMPLE data instead of calling the model.
# For offline UI testing only. Never presented as real model output.
DEMO_MODE=false
